# Public Supabase endpoint. This value is used by both the API and the web app.
SUPABASE_URL=https://your-project.supabase.co

# Browser-safe Supabase publishable/anon key. Never use this key for server administration.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only service role key. It is limited to Supabase Auth administration and
# private Storage operations; application data access always uses DATABASE_URL.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Used only by --seed-demo-accounts. Keep this local, high-entropy, and out of the
# repository; it is never used by normal registration or confirmation flows.
DEMO_SEED_PASSWORD=replace-with-a-demo-password-of-at-least-12-characters

# Npgsql connection string for the dedicated least-privileged application role through
# the Supabase Session Pooler. Do not use the Postgres superuser or service role here.
DATABASE_URL='Host=aws-0-region.pooler.supabase.com;Port=5432;Database=postgres;Username=app_user.project_ref;Password=replace-me;SSL Mode=Require'

# Used only to apply schema migrations. When omitted, DATABASE_URL is bootstrap authority.
# The migration creates the deterministic APP_DB_ROLE if needed; APP_DB_PASSWORD should be
# supplied by secret management for durable application configuration.
MIGRATION_DATABASE_URL='Host=db.your-project.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=replace-me;SSL Mode=Require'
APP_DB_ROLE=patient_data_portal_app_v1
APP_DB_PASSWORD=replace-with-a-random-secret

# Resend configuration. EMAIL_FROM must use the Resend-verified sending domain.
# Keep log mode for local development and CI. Set resend only in an approved environment
# where a real delivery check is intentionally being performed.
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=portal@your-verified-domain.example

# Public application URL used in email links and Supabase Auth redirect configuration.
APP_URL=http://localhost:3000

# Development only. Override the default 24-hour reminder lead time for the demo.
# Production ignores this value.
REMINDER_LEAD_MINUTES=5

# Server-only random values. Generate unique high-entropy values for every environment.
OUTBOX_JOB_SECRET=replace-with-a-random-secret
# Optional delivery-worker tuning. Defaults apply when omitted; keep the values positive.
OUTBOX_BACKGROUND_ENABLED=false
OUTBOX_POLL_SECONDS=5
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_MINUTES=5
AUDIT_HMAC_KEY=replace-with-a-random-secret
IDENTITY_HMAC_KEY=replace-with-a-random-secret

# Next.js public variables. Keep these equal to SUPABASE_URL and SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only API base URL used by the web application's authenticated profile proxy.
API_URL=http://localhost:5000
